---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import home from '../content/settings/home.json';

const projects = (await getCollection('projects', (p) => p.data.visible))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Base title="Dayton Massey — Process Engineer">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{home.eyebrow}</p>
      <h1>{home.headline}</h1>
      <p class="lede">{home.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Selected projects</h2>
        <a class="more" href="/projects/">All projects →</a>
      </div>
      <div class="grid-3">
        {projects.map((p, i) => (
          <a class="card" href={`/projects/${p.id}/`}>
            <img src={p.data.cover} alt={p.data.title} loading="lazy" />
            <div class="card-block">
              <div class="card-no">PRJ-{String(i + 1).padStart(3, '0')}</div>
              <h3>{p.data.title}</h3>
              <p>{p.data.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Latest writing</h2>
        <a class="more" href="/blog/">All posts →</a>
      </div>
      <ul class="post-list">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`}>{p.data.title}</a>
            <span class="post-date">{fmt(p.data.date)}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
