---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const fmt = project.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
---
<Base title={`${project.data.title} — Dayton Massey`} description={project.data.summary}>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Project · {fmt}</p>
      <h1>{project.data.title}</h1>
      <img src={project.data.cover} alt={project.data.title} style="border:1px solid var(--line); margin:2rem 0;" />
      <div class="prose">
        <Content />
      </div>
      {project.data.gallery.length > 0 && (
        <div class="gallery-strip">
          {project.data.gallery.map((img) => (
            <img src={img} alt={project.data.title} loading="lazy" />
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
